// EmorAI — Personal AI Platform
// Data model. SQLite in this sandbox; portable to PostgreSQL by swapping the
// datasource provider and DATABASE_URL (no model changes required).

generator client {
  provider = "prisma-client-js"
  // Deploy anywhere: bundle engines for this build host (native) plus the
  // common shared-hosting targets. Johnny (HelioHost) is rhel-openssl-3.0.x.
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Chat ────────────────────────────────────────────────────────────────────

model Folder {
  id            String         @id @default(cuid())
  name          String
  color         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
}

model Conversation {
  id            String    @id @default(cuid())
  title         String    @default("New chat")
  pinned        Boolean   @default(false)
  modelId       String
  folderId      String?
  folder        Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messages      Message[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime  @default(now())

  @@index([pinned, lastMessageAt])
  @@index([folderId])
  @@index([updatedAt])
}

model Message {
  id              String      @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // user | assistant | system
  role            String
  content         String
  // model requested by the user for assistant messages
  modelId         String?
  // model actually served by the provider (may differ)
  servedModel     String?
  // reasoning trace when the provider returns reasoning_content
  reasoning       String?
  webSearch       Boolean     @default(false)
  // [{ url, name, snippet, host_name }] for web-search augmented answers
  sources         Json?
  // [{ id, name, mime, size, kind }] attachments referencing FileMetadata
  attachments     Json?
  // complete | stopped | error
  status          String      @default("complete")
  errorText       String?
  promptTokens      Int?
  completionTokens  Int?
  totalTokens       Int?
  latencyMs       Int?
  createdAt       DateTime    @default(now())

  @@index([conversationId, createdAt])
}

// ─── Models ──────────────────────────────────────────────────────────────────

model ModelConfig {
  id              String    @id @default(cuid())
  // provider model identifier, e.g. "glm-5.3-flash"
  modelId         String    @unique
  displayName     String
  description     String    @default("")
  // zai | openai | anthropic | ... (adapter routing for future providers)
  provider        String    @default("zai")
  // emorai | provider — Category A (official unified family: emor-5.3, …)
  // vs Category B (upstream provider model exposed directly: glm-5.3, …)
  category        String    @default("provider")
  // draft | preview | active | deprecated | retired (model lifecycle)
  lifecycle       String    @default("active")
  // product generation for the EmorAI family, e.g. "5.3" (null for provider models)
  generation      String?
  // pricing metadata { inputPerMTok, outputPerMTok, currency } — admin-configured
  // only; never invented. null = not configured (reported as unknown)
  pricing         Json?
  // { chat, reasoning, vision, files, webSearch, tools, json }
  capabilities    Json
  freeTier        Boolean   @default(true)
  enabled         Boolean   @default(true)
  sortOrder       Int       @default(0)
  // context window in tokens, if known
  contextWindow   Int?
  // maximum output tokens, if known
  maxOutputTokens Int?
  // admin-configured alternate IDs (string[]) that resolve to this model.
  // Transparent: /v1/models exposes them and responses report the actual model.
  aliases         Json?
  // whether this model supports SSE streaming
  streamSupported Boolean   @default(true)
  // last health-probe result
  lastCheckedAt   DateTime?
  lastStatus      String?
  // what the provider gateway actually reported serving
  lastServedModel String?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ─── API keys (EmorAI developer API) ─────────────────────────────────────────

model ApiKey {
  id           String        @id @default(cuid())
  name         String
  // sha256 hash of the full plaintext key — plaintext is never stored
  keyHash      String        @unique
  // display prefix, e.g. "emr_a1b2c3…"
  prefix       String
  // permission scopes (string[]): chat | tools | vision | media | models | usage
  // null → full access (default). Enforced on every gateway request.
  scopes       Json?
  // per-key rate limit override (requests/min); null = global setting
  rateLimitPerMin Int?
  // monthly request limit; null = unlimited
  monthlyRequestLimit Int?
  // monthly token limit; null = unlimited
  monthlyTokenLimit   Int?
  // allowed model IDs (string[]); null = all models
  allowedModels Json?
  createdAt    DateTime      @default(now())
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  requestCount Int           @default(0)
  usageRecords UsageRecord[]
}

// ─── Settings ────────────────────────────────────────────────────────────────

model AppSetting {
  key       String   @id
  value     String // JSON-encoded payload
  updatedAt DateTime @updatedAt
}

// ─── Usage ───────────────────────────────────────────────────────────────────

model UsageRecord {
  id              String   @id @default(cuid())
  // dashboard | api
  source          String
  // wire protocol served: openai | anthropic | dashboard | internal
  protocol        String?
  // endpoint path, e.g. /api/v1/chat/completions
  endpoint        String?
  // HTTP status code returned to the caller
  statusCode      Int?
  // EmorAI request id (echoed as request-id header on gateway responses)
  requestId       String?
  apiKeyId        String?
  apiKey          ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  conversationId  String?
  modelId         String
  servedModel     String?
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  totalTokens     Int      @default(0)
  latencyMs       Int?
  success         Boolean  @default(true)
  errorText       String?
  // routing attribution (populated when the request went through the router)
  routeId           String?
  providerAccountId String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([apiKeyId, createdAt])
  @@index([protocol, createdAt])
}

// ─── Files ───────────────────────────────────────────────────────────────────

model FileMetadata {
  id             String   @id @default(cuid())
  name           String
  mime           String
  size           Int
  // image | document
  kind           String
  storagePath    String
  // text extracted server-side for document analysis
  extractedText  String?
  createdAt      DateTime @default(now())
}

// ─── Artifacts (Agent + Studio generated content) ───────────────────────────

model Artifact {
  id          String   @id @default(cuid())
  // website | blog | webapp | document | image | video | audio
  kind        String
  title       String
  description String   @default("")
  prompt      String?
  modelId     String?
  // pending | processing | ready | failed
  status      String   @default("ready")
  // multi-file outputs (websites/blogs/webapps): [{ path, content, entry }]
  files       Json?
  // single binary/text output stored at db/uploads/<artifact id>
  storagePath String?
  mime        String?
  size        Int?
  // provider async task id (video generation)
  providerTaskId String?
  error       String?
  // flexible extras: { size, voice, speed, format, quality, duration, withAudio }
  meta        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, createdAt])
  @@index([status])
}

// ─── Provider accounts (multi-provider infrastructure) ────────────────────────
// An authorized account on an upstream AI provider. Credentials are stored
// AES-256-GCM encrypted (src/lib/crypto.ts) with a master key from the
// environment — never plaintext. The bundled zai account uses
// credentialMode "platform": credentials are managed by the platform SDK
// environment, so no secret is stored at all.
model ProviderAccount {
  id             String       @id @default(cuid())
  name           String
  // zai | openai | anthropic | self-hosted (adapter key, see providers/index.ts)
  providerType   String
  // required for openai/anthropic/self-hosted adapters (base API URL)
  baseUrl        String?
  // AES-256-GCM ciphertext of the provider API key (null for platform mode)
  apiKeyEnc      String?
  // platform | stored — how credentials are supplied to the adapter
  credentialMode String        @default("platform")
  enabled        Boolean      @default(true)
  // operational priority when multiple accounts can serve a route (lower wins)
  priority       Int          @default(0)
  // bounded concurrent executions for this account (0 = unlimited)
  maxConcurrency Int          @default(0)
  // per-account monthly budget in accounting currency; null = no budget set
  monthlyBudget  Float?
  lastCheckedAt  DateTime?
  // ok | error | unknown (set by explicit validate/health actions and real executions)
  lastStatus     String?
  lastError      String?
  requestCount   Int          @default(0)
  routes         ModelRoute[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([providerType, enabled])
}

// ─── Model routes (EmorAI model → upstream execution path) ───────────────────
// Many-to-many: one EmorAI model generation maps to many upstream routes; one
// upstream model can back many EmorAI generations. A route existing in the DB
// does NOT make it eligible — the router verifies enabled + account health +
// capability subset before every selection.
model ModelRoute {
  id                String          @id @default(cuid())
  // public ModelConfig.modelId this route serves (e.g. "emor-5.3")
  publicModelId     String
  providerAccount   ProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)
  providerAccountId String
  // upstream model ID executed on the provider (e.g. "glm-5.3")
  upstreamModelId   String
  // route preference within the model (lower = preferred primary)
  priority          Int             @default(0)
  enabled           Boolean         @default(true)
  // capability subset verified for THIS route ({ chat, reasoning, vision, files,
  // webSearch, tools, json }); requests needing a capability outside this set
  // route elsewhere. null = inherit the public model's declared set.
  capabilities      Json?
  // bounded concurrent executions (0 = account default)
  maxConcurrency    Int             @default(0)
  // hard execution timeout for this route (ms)
  timeoutMs         Int             @default(120000)
  // cost/performance weight for balanced scoring (default 1.0)
  weight            Float           @default(1.0)
  // unknown | healthy | degraded | down — updated from real executions only
  healthStatus      String          @default("unknown")
  lastServedAt      DateTime?
  // latency of the most recent successful execution on THIS route (ms);
  // null = never measured. Performance-strategy scoring uses this only.
  lastLatencyMs     Int?
  lastError         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([publicModelId, priority])
  @@index([providerAccountId])
}

// ─── Routing decisions (admin transparency log) ──────────────────────────────
// One row per routed request: which public model was requested, which routes
// were candidates, which executed — and on failover, which failed and why.
model RoutingDecision {
  id              String   @id @default(cuid())
  requestId       String
  // public model ID requested by the caller
  modelId         String
  // routing strategy applied (balanced | priority | cost | performance)
  strategy        String   @default("balanced")
  // candidates considered: [{ routeId, upstreamModel, providerType, account,
  //   score, rejected, rejectReason }] — admin-facing, never sent to customers
  candidates      Json?
  selectedRouteId String?
  upstreamModel   String?
  providerType    String?
  attemptCount    Int      @default(1)
  // routed | failed | direct (direct = no routes configured, legacy path)
  finalStatus     String   @default("routed")
  errorText       String?
  latencyMs       Int?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([modelId, createdAt])
}
